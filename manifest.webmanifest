{
    "name": "Colour Palette Contrast Checker",
    "short_name": "Contrast Checker",
    "description": "Check the WCAG 2.2 colour contrast of every combination in your colour palette at once.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
